{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/commands/proactiveRecallCli.js\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/commands/refreshIndexCli.js\" \"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 120,
            "statusMessage": "Synapse : vérification de l'index mémoire…"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/commands/syncStatusCli.js\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 30,
            "statusMessage": "Synapse : radar de synchro git…"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/commands/postCompactCli.js\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 10,
            "statusMessage": "Synapse : réinjection des derniers résultats de recherche…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/commands/syncBrainCli.js\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 60,
            "statusMessage": "Synapse : synchronisation de la mémoire…"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/commands/syncBrainCli.js\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 60,
            "statusMessage": "Synapse : synchronisation de la mémoire…"
          }
        ]
      },
      {
        "matcher": "logout",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/commands/syncBrainCli.js\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 60,
            "statusMessage": "Synapse : synchronisation de la mémoire…"
          }
        ]
      },
      {
        "matcher": "prompt_input_exit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/commands/syncBrainCli.js\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 60,
            "statusMessage": "Synapse : synchronisation de la mémoire…"
          }
        ]
      },
      {
        "matcher": "bypass_permissions_disabled",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/commands/syncBrainCli.js\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 60,
            "statusMessage": "Synapse : synchronisation de la mémoire…"
          }
        ]
      },
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/commands/syncBrainCli.js\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 60,
            "statusMessage": "Synapse : synchronisation de la mémoire…"
          }
        ]
      }
    ]
  }
}
