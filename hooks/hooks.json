{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/commands/refreshIndexCli.js\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 120,
            "statusMessage": "Synapse : vérification de l'index mémoire…"
          }
        ]
      }
    ]
  }
}
