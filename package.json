{
  "name": "claude-synapse",
  "version": "0.1.4",
  "description": "Don't sync memory across machines — link it. A Claude Code plugin for a single memory hub referenced by junction/symlink from every machine and every project, never copied.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0"
  }
}
