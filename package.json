{
  "name": "claude-synapse",
  "version": "0.1.11",
  "description": "Don't sync memory across machines — link it. A Claude Code plugin for a single memory hub referenced by junction/symlink from every machine and every project, never copied.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
