{
  "name": "claude-synapse",
  "version": "0.1.3",
  "description": "Don't sync memory across machines — link it. A Claude Code plugin for a single memory hub referenced by junction/symlink from every machine and every project, never copied.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.8.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
